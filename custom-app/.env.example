APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── OTP ────────────────────────────────────────────────
OTP_PEPPER=
OTP_DEFAULT_CODE_LENGTH=6
OTP_DEFAULT_TTL=300
OTP_DEFAULT_CHANNEL_TIMEOUT=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Meta Cloud API
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_TEMPLATE_NAME=otp_authentication
META_TEMPLATE_LANG=id
META_GRAPH_VERSION=v21.0

# SMS
SMS_PROVIDER=jatis
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.jatismobile.com
SMS_WEBHOOK_SECRET=

# Guard nomor
PHONE_ALLOWED_PREFIXES=62
PHONE_DEFAULT_COUNTRY_CODE=62

# Circuit breaker
OTP_BREAKER_WINDOW=300
OTP_BREAKER_MIN_SAMPLES=10
OTP_BREAKER_ERROR_RATE=0.5
OTP_BREAKER_COOLDOWN=120

# Cache kemampuan nomor
OTP_PHONE_CAPABILITY_TTL_DAYS=30
