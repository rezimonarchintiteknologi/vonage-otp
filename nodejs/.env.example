# ---- Server ----
PORT=3000

# ---- Vonage (dashboard.nexmo.com -> API Settings) ----
VONAGE_API_KEY=your_api_key
VONAGE_API_SECRET=your_api_secret
VONAGE_TIMEOUT_MS=10000

# ---- OTP behaviour ----
# Nama yang muncul di pesan. Wajib, maks 16 karakter untuk beberapa channel.
OTP_BRAND=MonarchApp
OTP_CODE_LENGTH=6
# Detik sebelum Vonage pindah ke channel berikutnya. Range 15-900, default Vonage 180.
# 30 detik adalah kompromi yang baik untuk jaringan Indonesia.
OTP_CHANNEL_TIMEOUT=30
OTP_LOCALE=id-id
# Urutan channel. Maksimal 3 langkah. Opsi: silent_auth, whatsapp, sms, voice
OTP_CHANNELS=whatsapp,sms
# Berapa lama reference disimpan (detik)
OTP_REFERENCE_TTL=600
OTP_MAX_VERIFY_ATTEMPTS=5

# ---- Proteksi SMS pumping ----
# Hanya izinkan prefix negara ini. Pisahkan dengan koma.
PHONE_ALLOWED_PREFIXES=62
PHONE_DEFAULT_COUNTRY_CODE=62

# ---- Rate limit ----
RL_PHONE_MAX=3
RL_PHONE_WINDOW=900
RL_IP_MAX=10
RL_IP_WINDOW=900
